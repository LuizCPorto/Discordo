{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discordo",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Arquivos estáticos são servidos direto; só o que não existe (ex.: /api/turn) chega ao Worker.
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  // Secrets (TURN_KEY_ID, TURN_KEY_API_TOKEN, CF_ACCOUNT_ID, CF_ANALYTICS_TOKEN) ficam no painel.
  "keep_vars": true
}
